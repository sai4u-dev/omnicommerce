{
  "name": "desktop-vendor",
  "version": "1.0.0",
  "private": true,
  "description": "VÉLORA Vendor Desktop — Electron wrapper for Vendor Web (5175)",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "wait-on http://localhost:5175 --timeout 60000 && electron .",
    "dev:electron": "electron .",
    "dev:standalone": "concurrently \"pnpm --filter frontend-vendor dev -- --port 5175\" \"wait-on http://localhost:5175 --timeout 60000 && electron .\"",
    "build": "pnpm --filter frontend-vendor build && electron-builder",
    "build:web": "pnpm --filter frontend-vendor build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "eslint electron --ext .js",
    "test": "echo \"desktop-vendor: no tests yet\" && exit 0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.velora.vendor",
    "productName": "VÉLORA Vendor",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "../frontend-vendor/dist/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
