# ─────────────────────────────────────────────────────────
# OmniCommerce — Single Backend, Multiple Apps
# Copy to .env and fill values. Never commit .env
# ─────────────────────────────────────────────────────────

# Backend (Fastify :5000) — single backend for all apps
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-32+char-random-secret
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,exp://*,http://localhost:19006
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Database — file JSON for dev, postgres for prod
DB_PROVIDER=file
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicommerce?schema=public
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/omnicommerce

# Frontend Web (Vite)
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=OmniCommerce

# Expo Mobile — each mobile-* app reads EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_APP_VARIANT=user

# Electron Desktop — loads web build via file:// or http://localhost:5000
ELECTRON_API_URL=http://localhost:5000
ELECTRON_START_URL=http://localhost:5174

# Optional services
STRIPE_SECRET_KEY=sk_test_simulated_2026
OPENAI_API_KEY=
GEMINI_API_KEY=
S3_BUCKET=
CLOUDFRONT_URL=
