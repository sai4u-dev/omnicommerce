# OmniCommerce API — Env Example (copy to .env)
PORT=5000
NODE_ENV=development
HOST=0.0.0.0
JWT_SECRET=change-me-to-32+char-random-secret
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,exp://*,http://localhost:19006,http://192.168.1.7:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
DB_PROVIDER=file
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicommerce?schema=public
LOG_LEVEL=debug
